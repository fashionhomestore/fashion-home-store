backend:
  name: git-gateway
  branch: main

media_folder: "images/uploads"
public_folder: "/images/uploads"

locale: "fr"

collections:
  - name: "produits"
    label: "Catalogue Produits"
    files:
      - file: "data/products.json"
        label: "Tous les produits"
        name: "products"
        fields:
          - label: "Liste des produits"
            name: "products"
            widget: "list"
            summary: "{{fields.name}} — {{fields.price}} €"
            fields:
              - {label: "ID (ne pas dupliquer)", name: "id", widget: "number", value_type: "int"}
              - {label: "Nom du produit", name: "name", widget: "string"}
              - {label: "Sous-catégorie (ex: Jeans, Sneakers...)", name: "sub", widget: "string"}
              - label: "Catégorie"
                name: "cat"
                widget: "select"
                options:
                  - {label: "Pantalons", value: "pantalon"}
                  - {label: "Chemises", value: "chemise"}
                  - {label: "Chaussures", value: "chaussure"}
                  - {label: "Accessoires", value: "accessoire"}
                  - {label: "Polo", value: "polo"}
                  - {label: "T-shirt", value: "tshirt"}
                  - {label: "Pulls", value: "pull"}
                  - {label: "Blouzon", value: "blouzon"}
                  - {label: "Tenue d'ensemble", value: "ensemble"}
              - {label: "Prix (FCFA)", name: "price", widget: "number"}
              - {label: "Photo du produit", name: "img", widget: "image"}
              - {label: "Étiquette (optionnel: Nouveau / Best-seller)", name: "tag", widget: "string", required: false}
